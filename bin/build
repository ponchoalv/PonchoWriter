#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
  QMAKE=qmake
else
  echo "qmake6 or qmake is required to build omawrite." >&2
  exit 1
fi

JOBS="${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)}"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

# qmake can retain an old generated plist after ICON changes in an existing build.
if [ "$(uname -s)" = "Darwin" ]; then
  rm -f "$BUILD_DIR/omawrite.app/Contents/Info.plist"
fi

"$QMAKE" "$ROOT/omawrite.pro"
make -j"$JOBS"

if [ -x "$BUILD_DIR/omawrite.app/Contents/MacOS/omawrite" ]; then
  echo "Built $BUILD_DIR/omawrite.app (open it with: open \"$BUILD_DIR/omawrite.app\")"
else
  echo "Built $BUILD_DIR/omawrite"
fi
