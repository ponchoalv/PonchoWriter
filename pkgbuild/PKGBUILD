# Maintainer: Alfonso Alvarez (ponchoalv)

pkgname=ponchowriter
pkgver=0.7.2
pkgrel=1
pkgdesc='Dead-simple Markdown writing app built with Qt Quick'
arch=('x86_64' 'aarch64')
url='https://github.com/ponchoalv/PonchoWriter'
# Embedded syntax resources have additional, not-yet-audited terms.
license=('MIT' 'OFL-1.1' 'LGPL-2.1-or-later' 'LicenseRef-KSyntaxHighlighting-Resources')
install='ponchowriter.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

prepare() {
  printf '%s\n' 'This historical upstream recipe is disabled for the syntax-highlighting fork.' >&2
  printf '%s\n' 'Resource-license/source compliance must be audited before binary distribution; see third_party/ksyntaxhighlighting/README.md.' >&2
  return 1
}

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/ponchowriter "$pkgdir/usr/bin/ponchowriter"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  cp -R third_party/ksyntaxhighlighting "$pkgdir/usr/share/licenses/$pkgname/ksyntaxhighlighting"
  cp -R third_party/sonnet "$pkgdir/usr/share/licenses/$pkgname/sonnet"
  /usr/bin/install -Dm644 COPYRIGHT.md "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT.md"
  /usr/bin/install -Dm644 "$startdir/ponchowriter.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ponchowriter.svg"
  /usr/bin/install -Dm644 "$startdir/ponchowriter.desktop" "$pkgdir/usr/share/applications/ponchowriter.desktop"
}
