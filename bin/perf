#!/usr/bin/env sh
# Opt-in hardware-rendered benchmark. Not part of the correctness test suite.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
if [ "$#" -ne 2 ]; then echo 'Usage: bin/perf LABEL OUTPUT.json' >&2; exit 2; fi
case "${QT_QPA_PLATFORM:-}" in
  offscreen|minimal) echo 'Performance measurements require a native desktop platform.' >&2; exit 2 ;;
esac
LABEL="$1"
case "$2" in /*) OUTPUT="$2" ;; *) OUTPUT="$PWD/$2" ;; esac
mkdir -p "$(dirname -- "$OUTPUT")"
# Invalidate an older success before any build/run can fail. Publish atomically.
printf '{"complete":false,"status":"running"}\n' > "$OUTPUT"
REPORT=$(mktemp "$OUTPUT.pending.XXXXXX")
trap 'status=$?; rm -f "$REPORT"; if [ "$status" -ne 0 ]; then printf '\''{"complete":false,"status":"failed"}\n'\'' > "$OUTPUT"; fi' 0
trap 'exit 130' INT
trap 'exit 143' TERM HUP
if command -v qmake6 >/dev/null 2>&1; then QMAKE=qmake6; else QMAKE=qmake; fi
if { [ -z "${OMAWRITE_SYNTAX_PREFIX:-}" ] && [ ! -f "$ROOT/.deps/install/include/KF6/KSyntaxHighlighting/KSyntaxHighlighting/Repository" ]; } ||
   { [ -z "${OMAWRITE_SPELL_PREFIX:-}" ] && [ ! -f "$ROOT/.deps/install/include/KF6/SonnetCore/Sonnet/Speller" ]; }; then
  "$ROOT/bin/build-dependencies"
fi
BUILD_DIR="$ROOT/build-tests/performance"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"
"$QMAKE" "$ROOT/tests/performance/performance.pro"
make -j"${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)}"
EXECUTABLE=./tst_performance
if [ -x ./tst_performance.app/Contents/MacOS/tst_performance ]; then EXECUTABLE=./tst_performance.app/Contents/MacOS/tst_performance; fi
export OMAWRITE_PERF_LABEL="$LABEL" OMAWRITE_PERF_OUTPUT="$REPORT"
fingerprint() (
  cd "$ROOT"
  git ls-files --cached --others --exclude-standard -- "$@" | LC_ALL=C sort -u |
    while IFS= read -r path; do
      printf '%s ' "$path"
      if [ -f "$path" ]; then git hash-object -- "$path"; else printf 'missing\n'; fi
    done | git hash-object --stdin
)
OMAWRITE_PERF_HARNESS_SHA="$(fingerprint tests/performance bin/perf omawrite.pro syntax-highlighting.pri spellchecking.pri dependencies fonts)"
OMAWRITE_PERF_SOURCES_SHA="$(fingerprint src)"
export OMAWRITE_PERF_HARNESS_SHA OMAWRITE_PERF_SOURCES_SHA
OMAWRITE_PERF_REVISION="$(git -C "$ROOT" rev-parse HEAD)"; export OMAWRITE_PERF_REVISION
OMAWRITE_PERF_DIRTY=false
if ! git -C "$ROOT" diff --quiet HEAD -- src; then OMAWRITE_PERF_DIRTY=true; fi
export OMAWRITE_PERF_DIRTY
export QSG_RENDER_LOOP=threaded
"$EXECUTABLE"
grep -q '"complete": true' "$REPORT" || { echo 'Incomplete performance report.' >&2; exit 1; }
mv -f "$REPORT" "$OUTPUT"
