#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
  QMAKE=qmake
else
  echo "qmake6 or qmake is required to build ponchowriter." >&2
  exit 1
fi

if { [ -z "${PONCHOWRITER_SYNTAX_PREFIX:-}" ] && [ ! -f "$ROOT/.deps/install/include/KF6/KSyntaxHighlighting/KSyntaxHighlighting/Repository" ]; } ||
   { [ -z "${PONCHOWRITER_SPELL_PREFIX:-}" ] && [ ! -f "$ROOT/.deps/install/include/KF6/SonnetCore/Sonnet/Speller" ]; }; then
  "$ROOT/bin/build-dependencies"
fi

JOBS="${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)}"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

# qmake can retain an old generated plist after ICON changes in an existing build.
if [ "$(uname -s)" = "Darwin" ]; then
  rm -f "$BUILD_DIR/ponchowriter.app/Contents/Info.plist"
fi

"$QMAKE" "$ROOT/ponchowriter.pro"
make -j"$JOBS"

if [ -x "$BUILD_DIR/ponchowriter.app/Contents/MacOS/ponchowriter" ]; then
  echo "Built $BUILD_DIR/ponchowriter.app (open it with: open \"$BUILD_DIR/ponchowriter.app\")"
else
  echo "Built $BUILD_DIR/ponchowriter"
fi
