        <file alias="PreviewToggle.qml">PreviewToggle.qml</file>
        <file alias="CodeBlockControls.qml">CodeBlockControls.qml</file>
        <file alias="BlockOverflow.qml">BlockOverflow.qml</file>
        <file alias="TableGrid.qml">TableGrid.qml</file>
        <file alias="EditorDecorations.qml">EditorDecorations.qml</file>
        <file alias="AttachmentMenu.qml">AttachmentMenu.qml</file>
        <file alias="ShortcutsDialog.qml">ShortcutsDialog.qml</file>
        <file alias="SearchIconButton.qml">SearchIconButton.qml</file>
        <file alias="FooterIconButton.qml">FooterIconButton.qml</file>
        <file alias="SquareDialogButton.qml">SquareDialogButton.qml</file>
        <file alias="UnsavedChangesDialog.qml">UnsavedChangesDialog.qml</file>
        <file alias="ExternalChangeDialog.qml">ExternalChangeDialog.qml</file>
        <file alias="FontPicker.qml">FontPicker.qml</file>
        <file alias="EditorMutations.js">EditorMutations.js</file>
        <file alias="fonts/IBMPlexMono-Regular.ttf">../fonts/IBMPlexMono-Regular.ttf</file>
        <file alias="fonts/IBMPlexMono-Italic.ttf">../fonts/IBMPlexMono-Italic.ttf</file>
